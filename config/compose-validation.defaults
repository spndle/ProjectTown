# Public, non-secret defaults for scripts/validate_docker_runtime.ps1.
# This file deliberately is not named .env and contains no credentials.
PROJECTTOWN_API_PREFIX=/api/v1
PROJECTTOWN_MAX_WORKERS=4
PROJECTTOWN_MAX_FILE_BYTES=1000000
PROJECTTOWN_DEBUG=false
PROJECTTOWN_RUNTIME_API_PREFIX=/api/v2
PROJECTTOWN_RUNTIME_MAX_WORKERS=2
PROJECTTOWN_EXECUTION_LEASE_SECONDS=30
PROJECTTOWN_WEBSOCKET_POLL_SECONDS=0.1
PROJECTTOWN_WATCHDOG_THRESHOLD=3
PROJECTTOWN_TOOL_ALLOWLIST=check_markdown,check_python_syntax,list_directory,read_file,write_file
PROJECTTOWN_HIGH_RISK_TOOLS=
PROJECTTOWN_ENABLE_V1_RUNTIME=true
PROJECTTOWN_VERSION=3.0.0
