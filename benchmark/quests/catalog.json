    "deterministic_subset_repeats": 5,
    "tools": ["read", "write", "inspect"]
  },
  "task_templates": {
    "material_organization": {
      "title": "Local source synthesis",
      "goal": "Organize local source set {id} into a cited {length} study report.",
      "expected_artifacts": ["report.md", "citations.json"],
      "verifier": "section schema, citation IDs, keyword coverage"
    },
    "code_project": {
      "title": "Deterministic Python project",
      "goal": "Build and verify local Python fixture {id} at {length} complexity.",
      "expected_artifacts": ["src/main.py", "tests/test_main.py", "README.md"],
      "verifier": "tree shape, Python syntax, local tests"
    },
    "repository_maintenance": {
      "title": "Sandbox repository maintenance",
      "goal": "Apply bounded maintenance task {id} to the local {length} fixture.",
      "expected_artifacts": ["change_manifest.json", "verification.json"],
      "verifier": "changed-path scope, target checks, forbidden paths"
    }
  },
